<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.ChapterMapper">
  <insert id="insert" parameterType="com.example.entity.Chapter" useGeneratedKeys="true" keyProperty="id">
    insert into chapter(book_id,title,sort_no,content) values(#{bookId},#{title},#{sortNo},#{content})
  </insert>
  <update id="updateById" parameterType="com.example.entity.Chapter">
    update chapter set title=#{title},sort_no=#{sortNo},content=#{content} where id=#{id}
  </update>
</mapper>
