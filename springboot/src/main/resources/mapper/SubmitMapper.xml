<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.SubmitMapper">
  <select id="selectAll" resultType="com.example.entity.Submit">
    select s.*,u.name userName,h.title homeworkTitle from submit s left join `user` u on s.user_id=u.id left join homework h on s.homework_id=h.id
    <where>
      <if test="userId != null">and s.user_id=#{userId}</if>
      <if test="homeworkId != null">and s.homework_id=#{homeworkId}</if>
      <if test="status != null and status != ''">and s.status=#{status}</if>
    </where>
    order by s.submit_time desc
  </select>
  <insert id="insert" parameterType="com.example.entity.Submit" useGeneratedKeys="true" keyProperty="id">insert into submit(homework_id,user_id,file,content,status) values(#{homeworkId},#{userId},#{file},#{content},'SUBMITTED')</insert>
  <update id="grade" parameterType="com.example.entity.Submit">update submit set score=#{score},comment=#{comment},status='GRADED' where id=#{id}</update>
</mapper>
