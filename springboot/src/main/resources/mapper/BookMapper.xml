<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.BookMapper">
  <select id="selectAll" resultType="com.example.entity.Book">
    select * from book
    <where>
      <if test="name != null and name != ''">and (name like concat('%',#{name},'%') or author like concat('%',#{name},'%'))</if>
      <if test="category != null and category != ''">and category=#{category}</if>
      <if test="status != null and status != ''">and status=#{status}</if>
    </where>
    order by id desc
  </select>
  <insert id="insert" parameterType="com.example.entity.Book" useGeneratedKeys="true" keyProperty="id">
    insert into book(name,author,cover,category,publisher,isbn,description,total,stock,score,status) values(#{name},#{author},#{cover},#{category},#{publisher},#{isbn},#{description},#{total},#{stock},#{score},#{status})
  </insert>
  <update id="updateById" parameterType="com.example.entity.Book">
    update book set name=#{name},author=#{author},cover=#{cover},category=#{category},publisher=#{publisher},isbn=#{isbn},description=#{description},total=#{total},stock=#{stock},score=#{score},status=#{status} where id=#{id}
  </update>
</mapper>
