<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.HomeworkMapper">
  <select id="selectAll" resultType="com.example.entity.Homework">
    select h.*,t.name teacherName,(select count(*) from submit s where s.homework_id=h.id) submitCount
    from homework h left join teacher t on h.teacher_id=t.id
    <where>
      <if test="title != null and title != ''">and h.title like concat('%',#{title},'%')</if>
      <if test="teacherId != null">and h.teacher_id=#{teacherId}</if>
    </where>
    order by h.create_time desc
  </select>
  <insert id="insert" parameterType="com.example.entity.Homework" useGeneratedKeys="true" keyProperty="id">insert into homework(title,content,file,teacher_id,deadline) values(#{title},#{content},#{file},#{teacherId},#{deadline})</insert>
  <update id="updateById" parameterType="com.example.entity.Homework">update homework set title=#{title},content=#{content},file=#{file},deadline=#{deadline} where id=#{id}</update>
</mapper>
